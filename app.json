{
  "expo": {
    "name": "MiniStudio",
    "slug": "ministudio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ministudio",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ministudio.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MiniStudio needs camera access to capture photos of your miniatures.",
        "NSPhotoLibraryUsageDescription": "MiniStudio needs photo library access to import miniature images.",
        "NSPhotoLibraryAddUsageDescription": "MiniStudio needs permission to save generated images to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "package": "com.ministudio.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MiniStudio to access your camera to capture miniature photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MiniStudio to access your photos to import miniature images."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MiniStudio to save generated images to your photo library.",
          "savePhotosPermission": "Allow MiniStudio to save photos to your library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3b98bcbb-2ca8-4586-a4ea-35dadf760c76"
      }
    }
  }
}
